    {
      "id": "c80d80c1-f79f-4414-a73d-c3bfd55821b0",
      "name": "Configurar prueba T-78",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [360, 300],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "api-url", "name": "apiBaseUrl", "value": "http://127.0.0.1:8000", "type": "string" },
            { "id": "variant", "name": "nombreVariante", "value": "Prueba local compatible - T78", "type": "string" },
            { "id": "diameter", "name": "diametroNominalM", "value": 45.725, "type": "number" },
            { "id": "height", "name": "alturaLiquidoM", "value": 18.7, "type": "number" },
            { "id": "gravity", "name": "gravedadEspecifica", "value": 0.8778, "type": "number" },
            { "id": "sp", "name": "aceleracionPicoG", "value": 0.45, "type": "number" }
          ]
        }
      }
    },
    {
      "id": "4550c730-b62a-4720-967f-a47be7e90fd0",
      "name": "Comprobar API TANK650",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [620, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configurar prueba T-78').item.json.apiBaseUrl + '/api/v1/health' }}",
        "authentication": "none",
        "options": {}
      }
    },
    {
      "id": "37c8dde2-faa2-40be-903e-24e525609760",
      "name": "Cargar datos T-78",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [880, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configurar prueba T-78').item.json.apiBaseUrl + '/api/v1/fixtures/T78_2019' }}",
        "authentication": "none",
        "options": {}
      }
    },
    {
      "id": "77ffb060-ad2f-465e-a2fa-159e2e1475aa",
      "name": "Aplicar variantes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const source = $input.first().json;\nconst config = $('Configurar prueba T-78').first().json;\nconst inputs = JSON.parse(JSON.stringify(source));\n\ninputs.geometry = {\n  ...(inputs.geometry ?? {}),\n  nominal_diameter_m: Number(config.diametroNominalM),\n  design_liquid_height_m: Number(config.alturaLiquidoM),\n};\ninputs.product = {\n  ...(inputs.product ?? {}),\n  specific_gravity: Number(config.gravedadEspecifica),\n};\ninputs.seismic = {\n  ...(inputs.seismic ?? {}),\n  Sp: Number(config.aceleracionPicoG),\n};\n\nreturn [{\n  json: {\n    nombreVariante: config.nombreVariante,\n    inputs,\n  },\n}];"
      }
    },
    {
      "id": "86c79342-9b09-47ca-8da4-3c7075f937a4",
      "name": "Ejecutar cálculo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1400, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configurar prueba T-78').item.json.apiBaseUrl + '/api/v1/calculate' }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { inputs: $json.inputs } }}",
        "options": {}
      }
    },
    {
      "id": "ce1b54fa-23af-43bc-8cd1-a639fae2e0e8",
      "name": "Resumen de resultados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1660, 300],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "overall", "name": "estadoGlobal", "value": "={{ $json.summary.overall_status }}", "type": "string" },
            { "id": "engine", "name": "versionMotor", "value": "={{ $json.engine_version }}", "type": "string" },
            { "id": "hash", "name": "huellaEntradas", "value": "={{ $json.input_sha256 }}", "type": "string" },
            { "id": "j", "name": "jSismico", "value": "={{ $json.summary.seismic.J }}", "type": "number" },
            { "id": "shell", "name": "utilizacionCascoPct", "value": "={{ $json.summary.shell.max_utilization * 100 }}", "type": "number" },
            { "id": "hoop", "name": "utilizacionHoopPct", "value": "={{ $json.summary.seismic.max_hoop_utilization * 100 }}", "type": "number" },
            { "id": "bolts", "name": "pernosSeleccionados", "value": "={{ $json.summary.anchorage.selected_bolts }}", "type": "number" },
            { "id": "ai-results", "name": "resultadoTexto", "value": "={{ 'Resultados de la simulación TANK650. Estado global: ' + $json.summary.overall_status + '; versión del motor: ' + $json.engine_version + '; huella de entradas: ' + $json.input_sha256 + '; casco: ' + $json.summary.shell.status + ', utilización máxima ' + ($json.summary.shell.max_utilization * 100) + ' %; fondo: ' + $json.summary.bottom.status + '; viento: ' + $json.summary.wind.status + ', requiere anclajes ' + $json.summary.wind.anchors_required + '; sismo: ' + $json.summary.seismic.status + ', J ' + $json.summary.seismic.J + ', utilización hoop máxima ' + ($json.summary.seismic.max_hoop_utilization * 100) + ' %; autoanclaje: ' + $json.summary.auto_anchor.status + ', clasificación ' + $json.summary.auto_anchor.classification + '; anclaje mecánico requerido: ' + $json.summary.anchorage.required + ', estado ' + $json.summary.anchorage.status + ', pernos seleccionados ' + $json.summary.anchorage.selected_bolts + ', utilización máxima ' + ($json.summary.anchorage.max_utilization * 100) + ' %; peso vacío ' + $json.summary.weights.empty_N + ' N.' }}", "type": "string" },
            { "id": "result", "name": "resultadoCompleto", "value": "={{ $json }}", "type": "object" }
          ]
        }
      }
    },
    {
      "id": "d1ac2b24-c4c4-4e25-9b51-ac07bef33efb",
      "name": "Preparar conversación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const data = $input.first().json;\nlet pregunta = 'Genera un resumen técnico breve de los resultados e identifica los valores que requieren mayor atención.';\n\ntry {\n  const chat = $('Conversar sobre resultados').first().json;\n  if (chat?.chatInput) pregunta = String(chat.chatInput);\n} catch (_error) {\n  // La ejecución manual no activa el Chat Trigger; se conserva la pregunta predeterminada.\n}\n\nconst systemPrompt = 'Actúa como un asistente de ingeniería estructural especializado en tanques de almacenamiento y API 650. Responde exclusivamente sobre los resultados de la simulación proporcionada. No inventes valores, no uses información externa, no modifiques resultados ni afirmes que el diseño está certificado. Distingue claramente entre PASS, FAIL, advertencias y limitaciones. Si una pregunta no puede responderse con los resultados recibidos, indica que la información no está disponible en esta simulación. Responde en español, con unidades y lenguaje técnico claro.';\nconst chatInput = `Pregunta del usuario: ${pregunta}\\n\\n${data.resultadoTexto}`;\n\nreturn [{\n  json: {\n    ...data,\n    preguntaUsuario: pregunta,\n    chatInput,\n    deepSeekRequest: {\n      model: 'deepseek-flash',\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: chatInput },\n      ],\n      thinking: { type: 'disabled' },\n      max_tokens: 2000,\n      stream: false,\n    },\n  },\n}];"
      }
    },
    {
      "id": "b4793f58-7866-442c-8836-f3a381e7f33e",
      "name": "DeepSeek Flash 4.1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [2180, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "deepSeekApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.deepSeekRequest }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "deepSeekApi": {
          "id": "FHH0jcnzKoPX96dU",
          "name": "DeepSeek account"
        }
      }
    },
    {
      "id": "5c85a464-a2b4-437f-be14-0e918c16943e",
      "name": "Respuesta del asistente",
